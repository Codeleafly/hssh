# Binaries (leading / so cmd/hssh/ sources are never ignored)
bin/
/hssh

# Test / run scratch (logs, pids, temp binaries)
.run/

# Go build cache artifacts
*.test
*.out

# Local config / secrets (never commit)
hssh.json
.env
*.pem
*.key
*.crt

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
# Crash dumps (a panicking test binary can leave these behind)
core
